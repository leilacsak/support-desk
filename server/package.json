{
  "name": "support-desk-server",
  "version": "1.0.0",
  "description": "Support-desk app API (Node + Express)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node-pg-migrate",
