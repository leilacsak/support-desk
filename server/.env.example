
# HS256 signing secret for JWT acces tokens. This is credential.
#  - Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#    - NEVER commit the real secret.
JWT_SECRET=your_jwt_secret_here

# How long  an access token stays valid. Keep it short.
ACCESS_TOKEN_TTL=15m

# Bcrypt cost factor (1`-12 is the sane range)
BCRYPT_ROUNDS=12

DATABASE_URL=postgres://supportdesk:supportdesk@localhost:5432/supportdesk
PORT=4000
CORS_ORIGIN=*